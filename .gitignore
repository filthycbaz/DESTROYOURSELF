# dependencies
node_modules/
.pnp
.pnp.js

# testing / coverage
coverage/
test-results/

# production builds
build/

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cypress artifacts and local env overrides
client/cypress/videos/
client/cypress/screenshots/
client/cypress/downloads/
client/cypress.env.json
