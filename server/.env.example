# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto local de la API (Render lo asigna automáticamente en producción)
PORT=3001

# URI de conexión a MongoDB Atlas (o instancia local)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/destroyYourself

# Secreto usado para firmar los JWT — usa un valor largo y aleatorio
JWT_SECRET=cambia_este_valor_por_un_secreto_seguro

# URL del frontend desplegado — obligatoria en producción
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos por CORS, separados por comas.
# En desarrollo puede omitirse (se asume http://localhost:3000).
# En producción es obligatoria.
CORS_ALLOWED_ORIGINS=http://localhost:3000
